{
  "manifest_version": 3,
  "name": "Archive Cast",
  "version": "2.0.0",
  "description": "Cast whole shows to your Chromecast in order with autoplay — archive.org, podcasts and other video sites — without tab or screen casting. Scriptable by AI agents.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Archive Cast",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "scripting", "webRequest", "declarativeNetRequestWithHostAccess", "alarms"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": { "ids": ["*"] },
  "content_scripts": [
    {
      "matches": ["https://archive.org/*"],
      "js": ["castbridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://archive.org/*"],
      "js": ["lib/episodes.js", "lib/generic.js", "lib/commands.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
